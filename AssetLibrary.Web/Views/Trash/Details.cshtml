@model DeletedProjectDetailsViewModel

@{
    ViewData["Title"] = Model.ProjectName;

    const int retentionDays = 30;

    var assets = Model.Assets?.ToList() ?? new List<AssetCardViewModel>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/trash-details.css" asp-append-version="true" />
}

<div class="pd-wrap">

    <!-- Breadcrumb matching the Trash eyebrow style -->
    <div class="pd-eyebrow mb-3">
        <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Library</a> /
        <a asp-controller="Trash" asp-action="Index" class="text-decoration-none text-muted">Trash</a> /
        <span>Details</span>
    </div>

    <div class="alert alert-warning py-2 px-3 small mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <span>
            This project is in Trash and will be permanently deleted after
            <strong>@retentionDays days</strong>.
        </span>
    </div>

    <div class="pd-header">
        <p class="pd-eyebrow">Deleted project</p>
        <h1 class="pd-title">@Model.ProjectName</h1>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="pd-desc">@Model.Description</p>
        }

        <div class="pd-meta">
            @if (!string.IsNullOrWhiteSpace(Model.OwnerFirstName) || !string.IsNullOrWhiteSpace(Model.OwnerLastName))
            {
                <span>Owner: <strong>@Model.OwnerFirstName @Model.OwnerLastName</strong></span>
            }
            @if (Model.DeletedOn is not null)
            {
                <span>Deleted: <strong>@Model.DeletedOn.Value.ToLocalTime().ToString("MMM d, yyyy")</strong></span>
            }
            <span>
                Status:
                <span class="status-pill status-@Model.Status.ToString().ToLower()">@Model.Status</span>
            </span>
        </div>
    </div>

    @* Toolbar: asset count on left, action buttons on right *@
    <div class="pd-toolbar">
        <span class="pd-count">@assets.Count asset@(assets.Count == 1 ? "" : "s")</span>

        <div class="d-flex gap-2">
            <form asp-controller="Trash" asp-action="Restore" asp-route-id="@Model.ProjectId" method="post">
                <button type="submit" class="pd-add-btn border-0">Restore project</button>
            </form>

            <form asp-controller="Trash" asp-action="DeletePermanently" asp-route-id="@Model.ProjectId" method="post"
                  onsubmit="return confirm('Permanently delete this project and all its assets? This cannot be undone.');">
                <button type="submit" class="btn btn-outline-danger">Delete permanently</button>
            </form>
        </div>
    </div>

    @if (assets.Any())
    {
        <div class="asset-grid">
            @foreach (var asset in assets)
            {
                <div class="asset-card" style="cursor: default;">
                    <div class="asset-card-top">
                        <span class="asset-part-no">@(asset.PartNumber ?? "—")</span>
                        <span class="status-pill status-@asset.Status.ToString().ToLower()">@asset.Status</span>
                    </div>

                    <div>
                        <h5 class="asset-name" title="@asset.AssetName">@asset.AssetName</h5>
                        <span class="asset-material">@(asset.MaterialName ?? "No material set")</span>
                    </div>

                    <div class="asset-foot">
                        <span>Revisions: @asset.RevisionCount</span>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="pd-empty">No assets in this deleted project.</div>
    }
</div>