@model ProjectDetailsViewModel

@{
    ViewData["Title"] = Model.ProjectName;
}

@section Styles {
    <link rel="stylesheet" href="~/css/project-details.css" />
}

<div class="pd-wrap">

    <!-- Breadcrumb matching your Trash Details style -->
    <div class="pd-eyebrow mb-3">
        <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Library</a> /
        <span>Project Details</span>
    </div>

    <div class="pd-header">
        <p class="pd-eyebrow">Project</p>
        <h1 class="pd-title">@Model.ProjectName</h1>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="pd-desc">@Model.Description</p>
        }

        <div class="pd-meta">
            <span>Owner: <strong>@Model.OwnerFirstName @Model.OwnerLastName</strong></span>
            <span>Created: <strong>@Model.CreatedOn.ToString("MMM d, yyyy")</strong></span>
            <span>
                Status:
                <span class="status-pill status-@Model.Status.ToString().ToLower()">@Model.Status</span>
            </span>
        </div>
    </div>

    <div class="pd-toolbar">
        <span class="pd-count">@Model.Assets.Count asset@(Model.Assets.Count == 1 ? "" : "s")</span>
        <a class="pd-add-btn" asp-controller="Project" asp-action="Add" asp-route-id="@Model.ProjectId">
            Add asset
        </a>
    </div>

    @if (Model.Assets.Any())
    {
        <div class="asset-grid">
            @foreach (var asset in Model.Assets)
            {
                <partial name="_AssetCard" model="asset" />
            }
        </div>
    }
    else
    {
        <div class="pd-empty">
            No assets in this project yet.
            <a asp-controller="Project" asp-action="Add" asp-route-projectId="@Model.ProjectId">Add the first one.</a>
        </div>
    }
</div>