@model ProjectDetailsViewModel

@{
    ViewData["Title"] = Model.ProjectName;
}

@section Styles {
    <link rel="stylesheet" href="~/css/project-details.css" />
}

<div class="pd-wrap">
    <div class="pd-eyebrow mb-3">
        <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Library</a> /
        <span>Project Details</span>
    </div>

    <div class="pd-header">
        <p class="pd-eyebrow">Project</p>
        <h1 class="pd-title">@Model.ProjectName</h1>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="pd-desc">@Model.Description</p>
        }

        <div class="pd-meta">
            <span>Owner: <strong>@Model.OwnerFirstName @Model.OwnerLastName</strong></span>
            <span>Created: <strong>@Model.CreatedOn.ToString("MMM d, yyyy")</strong></span>
            <span>
                Status:
                <span class="status-pill status-@Model.Status.ToString().ToLower()">@Model.Status</span>
            </span>
        </div>
    </div>

    <div class="pd-toolbar">
        <span class="pd-count">@Model.Assets.Count asset@(Model.Assets.Count == 1 ? "" : "s")</span>
        <a class="pd-add-btn" asp-controller="Project" asp-action="Add" asp-route-id="@Model.ProjectId">
            Add asset
        </a>
    </div>

    @if (Model.Assets.Any())
    {
        <div class="asset-grid">
            @foreach (var asset in Model.Assets)
            {
                <partial name="_AssetCard" model="asset" />
            }
        </div>
    }
    else
    {
        <div class="pd-empty">
            No assets in this project yet.
            <a asp-controller="Project" asp-action="Add" asp-route-projectId="@Model.ProjectId">Add the first one.</a>
        </div>
    }
</div>

<partial name="_ModelViewerModal" />

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const inspectButtons = document.querySelectorAll('[data-action="inspect-model"]');

            inspectButtons.forEach(button => {
                button.addEventListener('click', function () {
                    const assetId = this.dataset.assetId;
                    const assetName = this.dataset.assetName;

                    document.getElementById('modelViewerAssetName').textContent = assetName;
                    document.getElementById('viewerStatus').textContent =
                        `Selected asset: ${assetId}`;

                    window.dispatchEvent(new CustomEvent('load-asset-model', {
                        detail: { 
                            assetId: assetId,
                            previewUrl: '@Url.Action("GetModelPreview", "Asset")' }
                    }));

                    const modalElement = document.getElementById('modelViewerModal');
                    const modal = bootstrap.Modal.getOrCreateInstance(modalElement);

                    modal.show();
                });
            });
        });
    </script>

    @if (ViewBag.UpdateThumbnail == true)
    {
        <div id="projectThumbnailUpdater"
             data-project-id="@Model.ProjectId"
             data-model-paths-url="@Url.Action("GetProjectModelPaths", "Project")"
             data-save-thumbnail-url="@Url.Action("UpdateProjectThumbnail", "Project")">
        </div>

        <form id="projectThumbnailAntiForgeryForm" class="d-none">
            @Html.AntiForgeryToken()
        </form>

        <script type="module" src="@Url.Content("~/dist/assets/uploadThumbnail-CL6k8Hvm.js")"></script>
    }
}



<script type="module" src="@Url.Content("~/dist/assets/viewer-DKb38B29.js")"></script>