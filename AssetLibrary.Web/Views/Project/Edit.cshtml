@using AssetLibrary.Data.Models.Enum
@model EditProjectViewModel

@{
    ViewData["Title"] = "Edit Project";
}

<div class="container py-4">
    <!-- Back Navigation -->
    <div class="mb-3">
        <a asp-controller="Project" asp-action="Details" asp-route-id="@Model.ProjectId" class="text-decoration-none text-muted fw-semibold">
            &larr; Back to project
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-md-5">

                    <!-- Header -->
                    <div class="mb-4">
                        <h2 class="fw-bold mb-1">Edit Project</h2>
                        <p class="text-muted small">Update the details for your project below.</p>
                    </div>

                    <!-- Form -->
                    <form asp-action="Edit" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small py-2" role="alert"></div>

                        <input type="hidden" asp-for="ProjectId" />

                        <div class="form-group mb-3">
                            <label asp-for="ProjectName" class="form-label fw-semibold"></label>
                            <input asp-for="ProjectName" class="form-control rounded-3" placeholder="Enter project name..." />
                            <span asp-validation-for="ProjectName" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Description" class="form-label fw-semibold"></label>
                            <textarea asp-for="Description" class="form-control rounded-3" rows="4" placeholder="Enter a brief description..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Status" class="form-label fw-semibold"></label>
                            <select asp-for="Status" class="form-select rounded-3"
                                    asp-items="Html.GetEnumSelectList<Status>()"></select>
                            <span asp-validation-for="Status" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Actions -->
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a asp-controller="Project" asp-action="Details" asp-route-id="@Model.ProjectId"
                               class="btn btn-outline-secondary px-4 rounded-pill">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4 rounded-pill shadow-sm">Save changes</button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}