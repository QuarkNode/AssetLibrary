@model AddAssetViewModel

@{
    ViewData["Title"] = "Add Asset";
}

<div class="container py-5">
    <!-- Back Navigation -->
    <div class="row justify-content-center mb-3">
        <div class="col-lg-8 col-md-10">
            <a asp-controller="Project" asp-action="Details" asp-route-id="@Model.ProjectId" class="text-decoration-none text-muted fw-semibold small">
                &larr; Back to project
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            
            <!-- Simple & Clean Header with Project Badge -->
            <div class="d-flex justify-content-between align-items-end mb-4">
                <div>
                    <h1 class="h3 fw-bold text-dark mb-1">Add Asset</h1>
                    <p class="text-muted small mb-0">Upload a new 3D model part to this project.</p>
                </div>
                @if (!string.IsNullOrEmpty(Model.ProjectName))
                {
                    <span class="badge bg-light text-secondary border px-3 py-2 rounded-3 fw-semibold small">
                        <i class="bi bi-folder2-open me-1 text-primary"></i> @Model.ProjectName
                    </span>
                }
            </div>

            <!-- Sleek Card Container -->
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="card-body p-4 p-md-5 bg-white">
                    <form asp-action="Add" method="post" enctype="multipart/form-data" class="needs-validation">
                        
                        <!-- Validation Summary -->
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 small py-2" role="alert"></div>

                        <input type="hidden" asp-for="ProjectId" />

                        <!-- Section: Asset Details -->
                        <div class="mb-4">
                            <h2 class="h6 text-uppercase text-muted fw-bold mb-3 tracking-wider">
                                <i class="bi bi-info-circle text-primary me-2"></i> Asset Details
                            </h2>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label asp-for="PartNumber" class="form-label fw-semibold small"></label>
                                    <input asp-for="PartNumber" class="form-control form-control-lg fs-6 rounded-3" placeholder="e.g. PN-1001" />
                                    <span asp-validation-for="PartNumber" class="text-danger small mt-1 d-block"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="AssetName" class="form-label fw-semibold small"></label>
                                    <input asp-for="AssetName" class="form-control form-control-lg fs-6 rounded-3" placeholder="e.g. Motor Mount" />
                                    <span asp-validation-for="AssetName" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Description" class="form-label fw-semibold small"></label>
                                <textarea asp-for="Description" class="form-control rounded-3" rows="3" placeholder="Provide a short description of this asset..."></textarea>
                                <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <hr class="text-muted opacity-25 my-4">

                        <!-- Section: Specifications & File -->
                        <div class="mb-4">
                            <h2 class="h6 text-uppercase text-muted fw-bold mb-3 tracking-wider">
                                <i class="bi bi-file-earmark-arrow-up text-primary me-2"></i> Specifications &amp; File
                            </h2>

                            <div class="mb-3">
                                <label asp-for="MaterialId" class="form-label fw-semibold small"></label>
                                <select asp-for="MaterialId" class="form-select form-select-lg fs-6 rounded-3" asp-items="Model.Materials">
                                    <option value="">-- None --</option>
                                </select>
                                <span asp-validation-for="MaterialId" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div>
                                <label asp-for="File" class="form-label fw-semibold small">3D Model File</label>
                                <div class="file-upload-wrapper border border-2 border-dashed rounded-3 p-4 text-center bg-light">
                                    <i class="bi bi-cloud-upload display-6 text-primary mb-2 d-block"></i>
                                    <input asp-for="File" type="file" class="form-control form-control-sm border-0 bg-transparent mx-auto w-auto" accept=".obj,.stl,.fbx" />
                                    <div class="form-text text-muted mt-2">
                                        Accepted formats: <span class="badge bg-secondary text-light">.obj</span> <span class="badge bg-secondary text-light">.stl</span> <span class="badge bg-secondary text-light">.fbx</span>
                                    </div>
                                </div>
                                <span asp-validation-for="File" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a asp-controller="Project" asp-action="Details" asp-route-id="@Model.ProjectId" class="btn btn-light px-4 py-2 rounded-3 text-secondary fw-semibold border">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-primary px-5 py-2 rounded-3 fw-semibold shadow-sm">
                                <i class="bi bi-cloud-upload me-2"></i> Add Asset
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}