@model UploadAssetViewModel

@{
    ViewData["Title"] = "Upload Asset";
}

@section Styles {
    <link rel="stylesheet" href="~/css/project-upload.css" asp-append-version="true" />
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            
            <!-- Simple & Clean Header -->
            <div class="mb-4">
                <h1 class="h3 fw-bold text-dark mb-1">Upload 3D Asset</h1>
                <p class="text-muted small mb-0">Add a new 3D model and link it to your engineering projects.</p>
            </div>

            <!-- Sleek Card Container -->
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="card-body p-4 p-md-5 bg-white">
                    <form asp-controller="Project" asp-action="Upload" method="post" enctype="multipart/form-data" class="needs-validation">

                        <!-- Validation Summary -->
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 shadow-sm rounded-3 mb-4" role="alert"></div>
                        }

                        <!-- Section: Asset Details -->
                        <div class="mb-4">
                            <h2 class="h6 text-uppercase text-muted fw-bold mb-3 tracking-wider">
                                <i class="bi bi-info-circle text-primary me-2"></i> Asset Details
                            </h2>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="PartNumber" class="form-label fw-semibold small"></label>
                                    <input asp-for="PartNumber" class="form-control form-control-lg fs-6 rounded-3" placeholder="e.g. PN-1001" />
                                    <span asp-validation-for="PartNumber" class="text-danger small mt-1 d-block"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="AssetName" class="form-label fw-semibold small"></label>
                                    <input asp-for="AssetName" class="form-control form-control-lg fs-6 rounded-3" placeholder="e.g. Motor Mount" />
                                    <span asp-validation-for="AssetName" class="text-danger small mt-1 d-block"></span>
                                </div>

                                <div class="col-12">
                                    <label asp-for="Description" class="form-label fw-semibold small"></label>
                                    <textarea asp-for="Description" class="form-control rounded-3" rows="3"
                                              placeholder="Short description of the part components..."></textarea>
                                    <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>
                        </div>

                        <hr class="text-muted opacity-25 my-4">

                        <!-- Section: Project Assignment (Pure CSS Toggle Tabs) -->
                        <div class="mb-4">
                            <h2 class="h6 text-uppercase text-muted fw-bold mb-3 tracking-wider">
                                <i class="bi bi-folder text-primary me-2"></i> Project Assignment
                            </h2>

                            <div class="project-tab-container">
                                <!-- Hidden Radio Buttons acting as Tab Controllers -->
                                <input type="radio" class="btn-check" name="IsNewProject" id="modeExisting" value="false" @(!Model.IsNewProject ? "checked" : "")>
                                <input type="radio" class="btn-check" name="IsNewProject" id="modeNew" value="true" @(Model.IsNewProject ? "checked" : "")>

                                <!-- Segmented Switcher Buttons -->
                                <div class="btn-group w-100 mb-4 p-1 bg-light rounded-3 border" role="group">
                                    <label class="btn btn-outline-secondary border-0 rounded-3 py-2 fw-semibold text-dark tab-btn-existing" for="modeExisting">
                                        <i class="bi bi-folder2-open me-2"></i> Existing Project
                                    </label>
                                    <label class="btn btn-outline-secondary border-0 rounded-3 py-2 fw-semibold text-dark tab-btn-new" for="modeNew">
                                        <i class="bi bi-folder-plus me-2"></i> New Project
                                    </label>
                                </div>

                                <!-- Pane Container (Pure CSS Visibility Swap) -->
                                <div class="project-panes">
                                    <!-- Existing Project Pane -->
                                    <div class="pane" id="existingProjectPane">
                                        <label asp-for="ProjectId" class="form-label fw-semibold small"></label>
                                        <select asp-for="ProjectId" asp-items="Model.Projects" class="form-select form-select-lg fs-6 rounded-3">
                                            <option value="">-- Select an existing project --</option>
                                        </select>
                                        <span asp-validation-for="ProjectId" class="text-danger small mt-1 d-block"></span>
                                    </div>

                                    <!-- New Project Pane -->
                                    <div class="pane" id="newProjectPane">
                                        <div class="mb-3">
                                            <label asp-for="NewProjectName" class="form-label fw-semibold small"></label>
                                            <input asp-for="NewProjectName" class="form-control form-control-lg fs-6 rounded-3"
                                                   placeholder="e.g. Drone Concept Design" />
                                            <span asp-validation-for="NewProjectName" class="text-danger small mt-1 d-block"></span>
                                        </div>

                                        <div>
                                            <label asp-for="NewProjectDescription" class="form-label fw-semibold small"></label>
                                            <textarea asp-for="NewProjectDescription" class="form-control rounded-3" rows="2"
                                                      placeholder="Brief project overview"></textarea>
                                            <span asp-validation-for="NewProjectDescription" class="text-danger small mt-1 d-block"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr class="text-muted opacity-25 my-4">

                        <!-- Section: Specifications & File -->
                        <div class="mb-4">
                            <h2 class="h6 text-uppercase text-muted fw-bold mb-3 tracking-wider">
                                <i class="bi bi-file-earmark-arrow-up text-primary me-2"></i> Specifications &amp; File
                            </h2>

                            <div class="mb-3">
                                <label asp-for="MaterialId" class="form-label fw-semibold small"></label>
                                <select asp-for="MaterialId" asp-items="Model.Materials" class="form-select form-select-lg fs-6 rounded-3">
                                    <option value="">-- Select Material (Optional) --</option>
                                </select>
                                <span asp-validation-for="MaterialId" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div>
                                <label asp-for="File" class="form-label fw-semibold small">3D Model File</label>
                                <div class="file-upload-wrapper border border-2 border-dashed rounded-3 p-4 text-center bg-light">
                                    <i class="bi bi-cloud-upload display-6 text-primary mb-2 d-block"></i>
                                    <input asp-for="File" type="file" class="form-control form-control-sm border-0 bg-transparent mx-auto w-auto" accept=".obj,.stl,.fbx" />
                                    <div class="form-text text-muted mt-2">
                                        Accepted formats: <span class="badge bg-secondary text-light">.obj</span> <span class="badge bg-secondary text-light">.stl</span> <span class="badge bg-secondary text-light">.fbx</span>
                                    </div>
                                </div>
                                <span asp-validation-for="File" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-light px-4 py-2 rounded-3 text-secondary fw-semibold border">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-primary px-5 py-2 rounded-3 fw-semibold shadow-sm">
                                <i class="bi bi-check2-circle me-2"></i> Upload Asset
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>