@model EditAssetViewModel

@{
    ViewData["Title"] = "Edit Asset";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Edit Asset</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <!-- Hidden fields for identifiers -->
                        <input type="hidden" asp-for="AssetId" />

                        <!-- Display Validation Summary for general errors -->
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Part Number -->
                        <div class="mb-3">
                            <label asp-for="PartNumber" class="form-label fw-semibold"></label>
                            <input asp-for="PartNumber" class="form-control" placeholder="Enter part number..." />
                            <span asp-validation-for="PartNumber" class="text-danger"></span>
                        </div>

                        <!-- Asset Name -->
                        <div class="mb-3">
                            <label asp-for="AssetName" class="form-label fw-semibold"></label>
                            <input asp-for="AssetName" class="form-control" placeholder="Enter asset name..." />
                            <span asp-validation-for="AssetName" class="text-danger"></span>
                        </div>

                        <!-- Project Dropdown (Move Asset) -->
                        <div class="mb-3">
                            <label asp-for="ProjectId" class="form-label fw-semibold"></label>
                            <select asp-for="ProjectId" asp-items="Model.Projects" class="form-select">
                                <option value="">-- Select Project --</option>
                            </select>
                            <span asp-validation-for="ProjectId" class="text-danger"></span>
                        </div>

                        <!-- Material Dropdown -->
                        <div class="mb-3">
                            <label asp-for="MaterialId" class="form-label fw-semibold">Material</label>
                            <select asp-for="MaterialId" asp-items="Model.Materials" class="form-select">
                                <option value="">-- Select Material (Optional) --</option>
                            </select>
                            <span asp-validation-for="MaterialId" class="text-danger"></span>
                        </div>

                        <!-- Description -->
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-semibold"></label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter description..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <a asp-controller="Project" asp-action="Details" asp-route-id="@Model.ProjectId" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-save"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Enable Client-Side Validation -->
    <partial name="_ValidationScriptsPartial" />
}