@model EditAssetViewModel

@{
    ViewData["Title"] = "Edit Asset";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            
            <!-- Simple & Clean Header -->
            <div class="mb-4">
                <h1 class="h3 fw-bold text-dark mb-1">Edit Asset</h1>
                <p class="text-muted small mb-0">Update the details or change project assignment for this asset.</p>
            </div>

            <!-- Sleek Card Container -->
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="card-body p-4 p-md-5 bg-white">
                    <form asp-action="Edit" method="post">
                        <!-- Hidden fields for identifiers -->
                        <input type="hidden" asp-for="AssetId" />

                        <!-- Display Validation Summary for general errors -->
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 small py-2" role="alert"></div>

                        <!-- Part Number & Asset Name -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="PartNumber" class="form-label fw-semibold small"></label>
                                <input asp-for="PartNumber" class="form-control form-control-lg fs-6 rounded-3" placeholder="Enter part number..." />
                                <span asp-validation-for="PartNumber" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="AssetName" class="form-label fw-semibold small"></label>
                                <input asp-for="AssetName" class="form-control form-control-lg fs-6 rounded-3" placeholder="Enter asset name..." />
                                <span asp-validation-for="AssetName" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <!-- Project Dropdown (Move Asset) -->
                        <div class="mb-3">
                            <label asp-for="ProjectId" class="form-label fw-semibold small"></label>
                            <select asp-for="ProjectId" asp-items="Model.Projects" class="form-select form-select-lg fs-6 rounded-3">
                                <option value="">-- Select Project --</option>
                            </select>
                            <span asp-validation-for="ProjectId" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Material Dropdown -->
                        <div class="mb-3">
                            <label asp-for="MaterialId" class="form-label fw-semibold small">Material</label>
                            <select asp-for="MaterialId" asp-items="Model.Materials" class="form-select form-select-lg fs-6 rounded-3">
                                <option value="">-- Select Material (Optional) --</option>
                            </select>
                            <span asp-validation-for="MaterialId" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Description -->
                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-semibold small"></label>
                            <textarea asp-for="Description" class="form-control rounded-3" rows="3" placeholder="Enter description..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a asp-controller="Project" asp-action="Details" asp-route-id="@Model.ProjectId" class="btn btn-light px-4 py-2 rounded-3 text-secondary fw-semibold border">
                                <i class="bi bi-arrow-left me-1"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary px-5 py-2 rounded-3 fw-semibold shadow-sm">
                                <i class="bi bi-save me-1"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}