@model ReplaceAssetFileViewModel

@{
    ViewData["Title"] = "Replace file";
}

<div class="container py-5" style="max-width: 640px;">
    <h1 class="h3 fw-bold mb-1">Replace file</h1>
    <p class="text-muted">Asset: <strong>@Model.AssetName</strong></p>

    <div class="alert alert-warning">
        This removes <strong>all existing revisions</strong> of this asset and starts over at Rev 1 with the new file.
        To keep history, use <em>Upload New Revision</em> on the asset page instead.
    </div>

    <form asp-controller="Asset" asp-action="ReplaceFile" asp-route-id="@Model.AssetId"
          method="post" enctype="multipart/form-data"
          onsubmit="return confirm('Replace the file and delete all previous revisions? This cannot be undone.');">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="File" class="form-label">New file</label>
            <input asp-for="File" type="file" class="form-control" accept=".obj,.stl,.fbx" />
            <span asp-validation-for="File" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-danger">Replace file</button>
        <a asp-action="Details" asp-route-id="@Model.AssetId" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>