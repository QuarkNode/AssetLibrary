@model AssetCardViewModel

<div class="asset-card position-relative">
    <div class="asset-card-top">
        <span class="asset-part-no">@Model.PartNumber</span>

        <div class="d-flex align-items-center gap-2">
            <span class="status-pill status-@Model.Status.ToString().ToLower()">@Model.Status</span>

            <div class="dropdown position-relative z-2">
                <button class="dropdown-toggle-btn"
                        type="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                        title="Options">
                    &#8285;
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <a class="dropdown-item" asp-controller="Asset" asp-action="Edit" asp-route-id="@Model.AssetId">
                            Edit Details
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" asp-controller="Asset" asp-action="ReplaceFile" asp-route-id="@Model.AssetId">
                            Upload New Version
                        </a>
                    </li>
                    <li><hr class="dropdown-divider my-1"></li>
                    <li>
                        <form asp-controller="Asset" asp-action="Delete" asp-route-id="@Model.AssetId" method="post"
                              onsubmit="return confirm('Delete this asset permanently? This cannot be undone.');">
                            <button type="submit" class="dropdown-item text-danger">Delete Asset</button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <p class="asset-name">
        <a class="stretched-link text-decoration-none text-reset"
           asp-controller="Asset" asp-action="Details" asp-route-id="@Model.AssetId">@Model.AssetName</a>
    </p>
    <span class="asset-material">@(Model.MaterialName ?? "No material set")</span>

    <div class="asset-foot">
        <span>Revisions: @(Model.CurrentRevisionNumber?.ToString() ?? "—")</span>
    </div>
</div>