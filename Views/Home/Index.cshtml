@model HomeViewModel

@{
    ViewData["Title"] = "Home";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home-index.css" asp-append-version="true" />
}

<div class="home-wrap">
    @if (!Model.IsLoggedIn)
    {
        <section class="text-black rounded-3 p-5 text-center mt-4">
            <h1 class="display-6 fw-bold">Your 3D parts, organized.</h1>
            <p class="lead text-secondary mb-4">
                Upload STL, OBJ and FBX files, group them into projects, and keep every revision.
            </p>
            <a class="btn btn-primary btn-lg me-2" asp-controller="Account" asp-action="Login">Sign in</a>
            <a class="btn btn-outline-dark btn-lg me-2" asp-controller="Account" asp-action="Register">Make an account</a>
        </section>
    }
    else
    {
        <div class="home-header">
            <p class="home-eyebrow">Library</p>
            <h1 class="home-title">Your Projects</h1>
            <span class="home-count">@Model.ProjectCount project@(Model.ProjectCount == 1 ? "" : "s")</span>
        </div>

        @if (Model.Projects != null && Model.Projects.Any())
        {
            <div class="row g-3">
                @foreach (var project in Model.Projects)
                {
                    <div class="col-sm-6 col-lg-4">
                        <!-- Custom classes from CSS file -->
                        <div class="card project-card h-100 position-relative">

                            <div class="project-thumb position-relative">
                                <div class="thumb-media">
                                    @if (!string.IsNullOrEmpty(project.ThumbnailUrl))
                                    {
                                        <img src="@project.ThumbnailUrl" alt="@project.ProjectName thumbnail" />
                                    }
                                    else
                                    {
                                        <svg class="is-placeholder" xmlns="http://www.w3.org/2000/svg" fill="none"
                                             stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M12 2 3 7v10l9 5 9-5V7l-9-5Z" />
                                            <path d="M3 7l9 5 9-5M12 12v10" />
                                        </svg>
                                    }
                                </div>

                                <!-- Three dot Dropdown Menu -->
                                <div class="dropdown position-absolute top-0 end-0 m-2" style="z-index: 10;">
                                    <button class="btn btn-sm btn-light shadow-sm dropdown-toggle-btn"
                                            type="button"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false"
                                            title="Project Options">
                                        &#8285;
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                        <li>
                                            <a class="dropdown-item" asp-controller="Project" asp-action="Edit" asp-route-id="@project.ProjectId">
                                                Edit Project
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider my-1"></li>
                                        <li>
                                            <form asp-controller="Project" asp-action="Delete" asp-route-id="@project.ProjectId" method="post"
                                                  onsubmit="return confirm('Are you sure you want to delete @project.ProjectName?');">
                                                <button type="submit" class="dropdown-item text-danger">
                                                    Delete Project
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </div>

                            <div class="card-body">
                                <h5 class="card-title mb-1 fw-bold">
                                    <!-- Stretched-link leverages your card's custom CSS behavior while using proper ASP.NET Core routing -->
                                    <a asp-controller="Project" asp-action="Details" asp-route-id="@project.ProjectId"
                                       class="text-decoration-none text-dark stretched-link">
                                        @project.ProjectName
                                    </a>
                                </h5>
                                <span class="asset-count" style="z-index: 1;">
                                    @project.AssetCount @(project.AssetCount == 1 ? "asset" : "assets")
                                </span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="home-empty">
                <p>No projects yet.</p>
                <a asp-controller="Project" asp-action="Upload" class="btn btn-sm btn-outline-primary mt-2">
                    Upload your first asset
                </a> to get started.
            </div>
        }
    }
</div>