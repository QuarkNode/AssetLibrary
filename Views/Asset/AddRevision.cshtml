@model AddRevisionViewModel

@{
    ViewData["Title"] = "Upload New Revision";
}

<div class="container py-4">
    <!-- Back Navigation -->
    <div class="mb-3">
        <a asp-controller="Asset" asp-action="Details" asp-route-id="@Model.AssetId" class="text-decoration-none text-muted fw-semibold">
            &larr; Back to asset
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-md-5">

                    <!-- Header -->
                    <div class="mb-4">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <h2 class="fw-bold mb-0">Upload New Revision</h2>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6 px-3 py-2 rounded-pill">
                                Rev @Model.NextRevisionNumber
                            </span>
                        </div>
                        <p class="text-muted small mb-0">
                            Asset: <strong class="text-dark">@Model.AssetName</strong>
                        </p>
                    </div>

                    <!-- Form -->
                    <form asp-action="AddRevision" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small py-2" role="alert"></div>

                        <input type="hidden" asp-for="AssetId" />

                        <!-- File Input -->
                        <div class="form-group mb-3">
                            <label asp-for="File" class="form-label fw-semibold">3D Model File</label>
                            <input asp-for="File" type="file" class="form-control rounded-3" accept=".obj,.stl,.fbx" />
                            <div class="form-text text-muted small mt-1">
                                Accepted formats: <code>.obj</code>, <code>.stl</code>, <code>.fbx</code>
                            </div>
                            <span asp-validation-for="File" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Change Notes -->
                        <div class="form-group mb-4">
                            <label asp-for="ChangeNotes" class="form-label fw-semibold">Change Notes</label>
                            <textarea asp-for="ChangeNotes" class="form-control rounded-3" rows="4"
                                      placeholder="e.g. Thickened the mounting arms by 2 mm"></textarea>
                            <span asp-validation-for="ChangeNotes" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a asp-controller="Asset" asp-action="Details" asp-route-id="@Model.AssetId"
                               class="btn btn-outline-secondary px-4 rounded-pill">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4 rounded-pill shadow-sm">
                                Upload Revision
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>
