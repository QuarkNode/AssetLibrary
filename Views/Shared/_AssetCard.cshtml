@model Asset

<div class="asset-card" onclick="if(!event.target.closest('.dropdown')) location.href='@Url.Action("Details", "Asset", new { id = Model.AssetId })';">
    <div class="asset-card-top">
        <span class="asset-part-no">@Model.PartNumber</span>

        <div class="d-flex align-items-center gap-2">
            <span class="status-pill status-@Model.Status.ToString().ToLower()">@Model.Status</span>

            <!-- Dropdown Menu -->
            <div class="dropdown" onclick="event.stopPropagation();">
                <button class="dropdown-toggle-btn"
                        type="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                        title="Options">
                    &#8285;
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <a class="dropdown-item" href="@Url.Action("Edit", "Asset", new { id = Model.AssetId })">
                            Edit Details
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" href="@Url.Action("ReplaceFile", "Asset", new { id = Model.AssetId })">
                            Upload New Version
                        </a>
                    </li>
                    <li><hr class="dropdown-divider my-1"></li>
                    <li>
                        <button class="dropdown-item text-danger"
                                type="button"
                                onclick="confirmDelete(@Model.AssetId, '@Model.AssetName')">
                            Delete Asset
                        </button>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <p class="asset-name">@Model.AssetName</p>
    <span class="asset-material">@(Model.Material?.MaterialName ?? "No material set")</span>

    <div class="asset-foot">
        <span>Revisions: @(Model.CurrentRevision?.RevisionNumber.ToString() ?? "—")</span>
    </div>
</div>