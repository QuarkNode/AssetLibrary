@model AddAssetViewModel

@{
    ViewData["Title"] = "Add Asset";
}

<div class="container py-4">
    <!-- Navigation Link -->
    <div class="mb-3">
        <a asp-controller="Project" asp-action="Details" asp-route-id="@Model.ProjectId" class="btn btn-sm btn-link text-decoration-none p-0 text-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to project
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-3">

                <!-- Card Header -->
                <div class="card-header bg-primary text-white p-3 rounded-top-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <h3 class="card-title mb-0 fs-4">
                            <i class="bi bi-plus-circle me-2"></i>Add Asset
                        </h3>
                        <span class="badge bg-light text-dark fs-6 font-monospace">
                            <i class="bi bi-folder2-open me-1"></i>@Model.ProjectName
                        </span>
                    </div>
                </div>

                <!-- Card Body -->
                <div class="card-body p-4">
                    <form asp-action="Add" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <input type="hidden" asp-for="ProjectId" />

                        <!-- Basic Information Section -->
                        <div class="mb-4">
                            <h5 class="text-secondary border-bottom pb-2 mb-3">Asset Details</h5>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label asp-for="PartNumber" class="form-label fw-bold"></label>
                                    <input asp-for="PartNumber" class="form-control" placeholder="e.g. PN-1001" />
                                    <span asp-validation-for="PartNumber" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="AssetName" class="form-label fw-bold"></label>
                                    <input asp-for="AssetName" class="form-control" placeholder="e.g. Motor Mount" />
                                    <span asp-validation-for="AssetName" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Description" class="form-label fw-bold"></label>
                                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Provide a short description of this asset..."></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Specifications and File Attachment Section -->
                        <div class="mb-4">
                            <h5 class="text-secondary border-bottom pb-2 mb-3">Specifications & File</h5>

                            <div class="mb-3">
                                <label asp-for="MaterialId" class="form-label fw-bold"></label>
                                <select asp-for="MaterialId" class="form-select" asp-items="Model.Materials">
                                    <option value="">-- None --</option>
                                </select>
                                <span asp-validation-for="MaterialId" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="File" class="form-label fw-bold">3D Model File</label>
                                <input asp-for="File" type="file" class="form-control" accept=".obj,.stl,.fbx" />
                                <div class="form-text">Accepted formats: <code>.obj</code>, <code>.stl</code>, <code>.fbx</code></div>
                                <span asp-validation-for="File" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Form Action Buttons -->
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a asp-controller="Project" asp-action="Details" asp-route-id="@Model.ProjectId" class="btn btn-outline-secondary px-4">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-cloud-upload me-1"></i> Add Asset
                            </button>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}